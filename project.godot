; Engine configuration file.
; Progetto creato per Godot 4.3+ (funziona anche con 4.4 / 4.5).

config_version=5

[application]

config/name="Granchietto (titolo provvisorio)"
config/description="Platform 2D pixel-art subacqueo - bozza di gruppo"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/autoload/game_state.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[layer_names]

2d_physics/layer_1="mondo"
2d_physics/layer_2="giocatore"
2d_physics/layer_3="nemici"
2d_physics/layer_4="oggetti"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.12, 0.25, 1)
